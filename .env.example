# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Production-trained model files. Generic Ultralytics starter weights are rejected.
QADDIR_DAMAGE_MODEL_PATH=
QADDIR_PART_MODEL_PATH=

# Explicit Ultralytics inference settings. Select these from checkpoint validation;
# no production inference cutoff or image size is assumed by the application.
QADDIR_CV_CONFIDENCE=
QADDIR_CV_IMAGE_SIZE=
QADDIR_CV_DEVICE=

# Frozen prompt supplied by the Ruba branch. Do not copy or edit that artifact.
# It was evaluated on Claude Sonnet 5 and requires re-evaluation on the exact
# QADDIR_LLM_MODEL selected here before presentation use.
QADDIR_LLM_PROMPT_PATH=prompts/production/prompt_production.md
OPENAI_API_KEY=
QADDIR_LLM_MODEL=

# Leave unset until TASK-18 and TASK-23 calibrate production policy.
QADDIR_T_DAMAGE_REPORT=
QADDIR_T_DAMAGE_HEDGE=
QADDIR_T_PART_REPORT=
QADDIR_T_ASSOC_STATE=
QADDIR_T_ASSOC_AMBIG=

# API controls
QADDIR_CORS_ORIGINS=http://localhost:3000
QADDIR_MAX_IMAGE_BYTES=10485760
QADDIR_MIN_IMAGE_SIDE=320
